# Machine settings for the dedicated Mac mini M4 / 16 GB test machine.
# Read by the backend at startup (backend/app/config.py). Only LAB_* keys are used.
# A LAB_* variable set in the shell takes precedence over this file.
# Restart the backend after editing.

# Concurrent running browsers. Default heuristic gives 25 on this machine;
# raised to 50 for performance testing (25 was confirmed stable), then to 100 for
# test convenience after 50 ran normally. Max registered sessions stays 100.
# Protection stays on: new starts are still refused at RAM >= LAB_RAM_THRESHOLD
# (default 85%) or memory pressure >= LAB_PRESSURE_BLOCK_LEVEL (default warn).
LAB_MAX_CONCURRENT=100
