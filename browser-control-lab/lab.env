# Machine settings for the dedicated Mac mini M4 / 16 GB test machine.
# Read by the backend at startup (backend/app/config.py). Only LAB_* keys are used.
# A LAB_* variable set in the shell takes precedence over this file.
# Restart the backend after editing.

# Concurrent running browsers. Default heuristic gives 25 on this machine;
# raised to 50 for performance testing (25 was confirmed stable), then to 100 for
# test convenience after 50 ran normally. Max registered sessions stays 100.
# Protection stays on: new starts are still refused at RAM >= LAB_RAM_THRESHOLD
# (default 85%) or memory pressure >= LAB_PRESSURE_BLOCK_LEVEL (default warn).
LAB_MAX_CONCURRENT=100

# ---- Custom URL scenario (see README "사용자 지정 URL 테스트") ----
# localhost / 127.0.0.1 are always allowed. Add ONLY hosts you own or are authorised to
# test (exact names, comma separated, no wildcards). Media/social platforms (YouTube,
# Twitch, TikTok, CHZZK, SOOP, ...) are always refused.
# LAB_CUSTOM_ALLOWED_HOSTS=test.my-site.com,staging.my-site.com
# Hosts allowed only for sub-resources (CDN, API) of those pages, never as the page itself:
# LAB_CUSTOM_RESOURCE_HOSTS=cdn.my-site.com
# Allow-listed names must resolve to public IPs (SSRF guard). For your own LAN/staging:
# LAB_CUSTOM_ALLOW_PRIVATE_NETWORK=1
# Optional fixed name->IP mapping (like /etc/hosts), e.g. a staging box:
# LAB_CUSTOM_HOST_OVERRIDES=staging.my-site.com=192.168.0.20
# External hosts must serve this lab's token at /.well-known/blc-lab-verify.txt (default on).
# LAB_CUSTOM_REQUIRE_VERIFICATION=1
